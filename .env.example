# Copy this file to .env and fill in only the providers you use.
# Never commit .env. Never paste real keys into README, screenshots, or issues.

# Local Ollama. Used first when it is running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Groq. Leave blank if you are not using it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face. Leave blank if you are not using it.
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Gemini. The web phishing, recon, and report APIs request this provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional MySQL history. Analysis still runs when MySQL is offline.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_security_user
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_security_platform

# Optional extra browser origins, comma-separated.
# http://localhost and http://127.0.0.1 on any port are already allowed.
CORS_EXTRA_ORIGINS=
